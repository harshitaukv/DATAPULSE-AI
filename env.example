# Copy to .env and fill in. Never commit .env.

# --- Application ---------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Database ------------------------------------------------------------
# Used only by docker compose for its PostgreSQL container
POSTGRES_PASSWORD=
# PostgreSQL (recommended). Leave empty to use the SQLite fallback in data/datapulse.db
DATABASE_URL=postgresql+psycopg2://datapulse:CHANGE_ME@localhost:5432/datapulse

# --- Security ------------------------------------------------------------
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_UPLOAD_MB=20
RETENTION_DAYS=90
# Users created on first start if they do not exist (choose your own strong passwords)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ENGINEER_USERNAME=engineer
BOOTSTRAP_ENGINEER_PASSWORD=
BOOTSTRAP_VIEWER_USERNAME=viewer
BOOTSTRAP_VIEWER_PASSWORD=
ENABLE_FAULT_INJECTION=true         # set false in production

# --- Data-quality thresholds (fractions) ----------------------------------
DUPLICATE_RATE_THRESHOLD=0.02
MISSING_RATE_THRESHOLD=0.05
INVALID_RATE_THRESHOLD=0.02
VOLUME_DROP_THRESHOLD=0.50
VOLUME_SPIKE_THRESHOLD=1.00
MIN_HISTORY_FOR_BASELINE=5
MIN_HISTORY_FOR_ML=10
IFOREST_CONTAMINATION=0.02
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5

# --- Generative AI (optional; the app works without it) -------------------
# openai_compatible works with OpenAI, Groq, Together, Mistral, OpenRouter, Ollama, LM Studio...
LLM_PROVIDER=openai_compatible      # openai_compatible | anthropic
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- RAG ------------------------------------------------------------------
EMBEDDING_BACKEND=auto              # auto | sentence_transformers | tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Dashboard (frontend only) --------------------------------------------
API_BASE_URL=http://localhost:8000
